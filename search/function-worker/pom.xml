<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.pipelineframework.search</groupId>
        <artifactId>search-pipeline</artifactId>
        <version>26.9.4-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>function-worker</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.pipelineframework.search</groupId>
            <artifactId>orchestrator-svc</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-amazon-lambda-http</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-amazon-lambda</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>pipelineframework-aws-durable-coordination-host</artifactId>
            <version>${pipelineframework.runtime.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-legacy-unpacked-handlers</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.outputDirectory}/org/pipelineframework/aws/durable/AwsDurableWorkItemHandler.class"/>
                                <delete file="${project.build.outputDirectory}/org/pipelineframework/aws/durable/AwsDurableDueWorkHandler.class"/>
                                <delete file="${project.build.outputDirectory}/org/pipelineframework/aws/durable/AwsDurableSqsBatchAdapter.class"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>build</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
